# NOTE: this file is copied verbatim by cargo-generate and is never processed by the template
# engine -- the double-brace interpolation below is just's own. It is project-agnostic: what a
# recipe needs to know it reads at run time -- pyproject.toml, and whether the root is a
# workspace (a root without a [project] table: uv's virtual root).
#
# Formatted with `just --fmt --unstable`. The commands are the workflows' (.github/workflows/).

[doc("List the recipes")]
default:
    @just --list --unsorted

[doc("The lock and the environment: the project, its dev group (`uv sync --locked`)")]
sync:
    uv sync --locked

[doc("Format the code, the Markdown and the TOML (modifies files)")]
format:
    uv run --locked ruff format
    dprint fmt

[doc("The code's format, checked")]
format-check:
    uv run --locked ruff format --check

[doc("The linter (modifies nothing)")]
lint:
    uv run --locked ruff check

[doc("format-check and lint")]
ruff-checks: format-check lint

[doc("Types: basedpyright blocks; ty is advisory, its failure ignored")]
static:
    uv run --locked basedpyright
    -uv run --locked ty check

[doc("Dead code")]
vulture:
    uv run --locked vulture

[doc("The tests, every line and branch covered ([tool.coverage])")]
pytest:
    uv run --locked pytest --cov -n auto

[doc("The lock matches the pyproject files")]
lock-check:
    uv lock --check

[doc("Markdown and TOML formatted (dprint.json)")]
dprint-check:
    dprint check

[doc("dprint's plugins to their latest releases (dprint.json), then everything rechecked")]
dprint-update:
    dprint config update
    dprint check

[doc("Every commit conventional (cog.toml)")]
cog:
    cog check

[doc("pip-audit over the lock, exported")]
audit:
    #!/usr/bin/env bash
    set -euo pipefail
    requirements=$(mktemp)
    trap 'rm -f "$requirements"' EXIT
    # every group, the workspace's own packages left out: they are this repository
    uv export --locked --all-packages --all-groups --no-emit-workspace \
        --format requirements.txt --quiet --output-file "$requirements"
    uv run --locked --isolated --only-group audit \
        pip-audit --strict --disable-pip --require-hashes -r "$requirements"

[doc("The flake: every system evaluated, this one's checks built")]
nix:
    nix flake check --no-build --all-systems
    nix flake check

# `nix` last: the slowest, and the one a machine without Nix cannot run -- every other has passed
# by then. The flake sees git's files only: a new file is invisible to it until `git add`ed.
[doc("Every check, the flake's last")]
checks: lock-check ruff-checks static vulture pytest dprint-check cog audit nix

[doc("Every package's sdist and wheel into dist/, as publish.yml builds them (--no-sources)")]
build:
    uv build --all-packages --no-sources

# Opt-in, as every git hook is: a clone never installs one, so CI stays the gate.
# `git config --unset core.hooksPath` turns them off again.
[doc("Use .githooks: the lock, ruff and dprint before a commit; Conventional Commits for the message and before a push")]
install-hooks:
    git config core.hooksPath .githooks

# git-cliff, offline, with the repository the compare links need read from pyproject.toml's
# Repository (cliff.toml is project-agnostic). In a workspace the package comes first: its
# folder's commits, its tags -- the name, `-v`, then a version's first number, so `foo-v2-v1.0.0`
# (a member foo-v2's) is no tag of foo's.
[doc("The changelog (cliff.toml): `just changelog [package] --unreleased` previews the next release")]
[positional-arguments]
changelog *args:
    #!/usr/bin/env bash
    set -euo pipefail
    if grep -q '^\[project\]' pyproject.toml; then
        manifest=pyproject.toml
        scope=(--tag-pattern '^v[0-9]+(\.|$)')
    else
        package="${1:?in a workspace, the package comes first: just changelog <package> ...}"
        shift
        manifest="packages/$package/pyproject.toml"
        [ -f "$manifest" ] || { echo "error: no workspace member $package (packages/$package)" >&2; exit 1; }
        scope=(--include-path "packages/$package/**" --tag-pattern "^${package//./\\.}-v[0-9]+(\\.|$)")
    fi
    url="$(sed -n 's/^Repository[[:space:]]*=[[:space:]]*"\([^"]*\)".*/\1/p' "$manifest")"
    case "$url" in
        https://github.com/*/*) repo="${url#https://github.com/}"; repo="${repo%.git}"; repo="${repo%/}" ;;
        *) echo "error: $manifest's Repository is not a GitHub URL (got '$url')" >&2; exit 1 ;;
    esac
    uv run --locked --isolated --only-group release \
        git-cliff --offline --config cliff.toml --github-repo "$repo" "${scope[@]}" "$@"

# Every step here, in order -- nothing in a hook or another tool's config. The version is uv's
# (`uv version --bump`); the first release is the version pyproject.toml declares, whatever the
# level. Single package: `just release minor`, tag v0.2.0. Workspace: `just release <package>
# minor`, tag <package>-v0.2.0. The tag publishes to PyPI and makes the GitHub release, of the
# same files (publish.yml). No tests here: what is released is origin's main, which CI checks.
[doc("Release: just release [package] <major|minor|patch> -- version, changelog, commit, tag")]
[positional-arguments]
release *args:
    #!/usr/bin/env bash
    set -euo pipefail

    # 0. The arguments -- passed as $1 and $2, never spliced into this script's text
    if grep -q '^\[project\]' pyproject.toml; then
        [ $# -eq 1 ] || { echo "usage: just release <major|minor|patch>" >&2; exit 1; }
        level="$1"; package=""; folder="."; prefix="v"
        manifests=(pyproject.toml)
    else
        [ $# -eq 2 ] || { echo "usage: just release <package> <major|minor|patch>" >&2; exit 1; }
        package="$1"; level="$2"; folder="packages/$package"; prefix="$package-v"
        [ -f "$folder/pyproject.toml" ] || { echo "error: no workspace member $package ($folder)" >&2; exit 1; }
        manifests=("$folder/pyproject.toml")
    fi
    case "$level" in
        major|minor|patch) ;;
        *) echo "error: the level must be major, minor or patch (got '$level')" >&2; exit 1 ;;
    esac
    version_of=(uv version --short ${package:+--package "$package"})
    changelog="$folder/CHANGELOG.md"

    # 1. From a clean main that is origin's -- pushed, so the commit released is the one CI ran on
    if [ -n "$(git status --porcelain)" ]; then
        echo "error: the working tree is not clean: commit or stash first" >&2; exit 1
    fi
    if [ "$(git branch --show-current)" != main ]; then
        echo "error: a release is cut from main" >&2; exit 1
    fi
    git fetch origin
    git rev-parse --quiet --verify origin/main > /dev/null \
        || { echo "error: origin has no main: push it first" >&2; exit 1; }
    if [ "$(git rev-parse HEAD)" != "$(git rev-parse origin/main)" ]; then
        echo "error: main is not origin/main: push (and let CI pass) or pull first" >&2; exit 1
    fi

    # 2. The version: the declared one at the first release (no tag yet), else uv's bump
    declared="$("${version_of[@]}")"
    # the package's tags, as `just changelog` matches them: the prefix, then a version
    released="$(git tag --list "${prefix}[0-9]*" | grep -E "^${prefix//./\\.}[0-9]+(\\.|$)" || true)"
    if [ -z "$released" ]; then
        version="$declared"; bump=false
    else
        version="$("${version_of[@]}" --bump "$level" --dry-run)"; bump=true
    fi
    tag="$prefix$version"
    if git rev-parse -q --verify "refs/tags/$tag" > /dev/null; then
        echo "error: $tag is already tagged" >&2; exit 1
    fi

    # 3. Something to release: a commit since the last tag that enters the changelog
    entries="$(just changelog ${package:+"$package"} --unreleased --context \
        | uv run --locked --isolated --only-group release python -c \
            'import json, sys; print(sum(len(r["commits"]) for r in json.load(sys.stdin)))')"
    if [ "$entries" -eq 0 ]; then
        echo "error: nothing to release -- no commit since the last tag would enter the changelog" >&2
        exit 1
    fi

    # 4. In a workspace, its members' requirements on each other, which uv's lock ignores (it takes
    #    a member from the workspace). Each member requiring this one admits its new version. Each
    #    member this one needs, directly or through another, is released as the workspace holds
    #    it -- its src and the fields an install reads (dependencies, scripts...) its latest tag's
    #    -- and on the index (a file not yanked: the Simple API's JSON, PEP 691); and every
    #    requirement between them admits that release, its floor no lower: then PyPI's links are
    #    the workspace's, and pip installs what was tested or newer, never an older one it keeps.
    #    RELEASE_INDEX_URL names another index (publish.yml's, if changed).
    if [ -n "$package" ]; then
        RELEASE_INDEX_URL="${RELEASE_INDEX_URL:-https://pypi.org/simple/}" \
            uv run --locked --isolated --only-group release python - "$package" "$version" <<'EOF'
    import json
    import os
    import subprocess
    import sys
    import tomllib
    import urllib.error
    import urllib.request
    from pathlib import Path

    from packaging.requirements import Requirement
    from packaging.utils import canonicalize_name, parse_sdist_filename, parse_wheel_filename
    from packaging.version import Version

    INDEX = os.environ["RELEASE_INDEX_URL"].rstrip("/")
    # what pip reads of a release to install and run it; the rest (the readme, classifiers,
    # [build-system]) changes no install
    INSTALLED = ("dependencies", "optional-dependencies", "requires-python", "scripts",
                 "gui-scripts", "entry-points")


    def git(*args):
        result = subprocess.run(["git", *args], capture_output=True, text=True, check=False)
        return result.stdout if result.returncode == 0 else None  # None: no such tag or path


    def released(folder, project, tag):
        # its src, and its installed fields, as the tag left them
        if git("diff", "--quiet", tag, "HEAD", "--", str(folder / "src")) is None:
            return False
        manifest = git("show", f"{tag}:{(folder / 'pyproject.toml').as_posix()}")
        if manifest is None:
            return False
        then = tomllib.loads(manifest)["project"]
        return all(then.get(field) == project.get(field) for field in INSTALLED)


    def on_index(name, version):
        accept = {"Accept": "application/vnd.pypi.simple.v1+json"}
        request = urllib.request.Request(f"{INDEX}/{name}/", headers=accept)
        try:
            with urllib.request.urlopen(request, timeout=30) as response:
                files = json.load(response)["files"]
        except urllib.error.HTTPError as error:
            if error.code == 404:  # no such project
                return False
            raise
        for file in files:
            filename = file["filename"]
            parse = parse_wheel_filename if filename.endswith(".whl") else parse_sdist_filename
            try:
                found = parse(filename)[1]
            except ValueError:  # neither a wheel nor an sdist (an egg): never pip's here
                continue
            if found == version and not file["yanked"]:
                return True
        return False


    # each member by its project name: its folder (its tags' prefix), its [project] table
    members = {}
    for manifest in sorted(Path("packages").glob("*/pyproject.toml")):
        project = tomllib.loads(manifest.read_text(encoding="utf-8"))["project"]
        members[canonicalize_name(project["name"])] = (manifest.parent, project)


    def version_of(name):
        return Version(members[name][1]["version"])


    def needs(name):
        # the members its requirements name, with those requirements
        for line in members[name][1].get("dependencies", []):
            req = Requirement(line)
            if canonicalize_name(req.name) in members:
                yield canonicalize_name(req.name), req


    folder, upcoming = Path("packages", sys.argv[1]), Version(sys.argv[2])
    this = next(name for name, (where, _) in members.items() if where == folder)
    errors = []
    for name in members:
        for needed, req in needs(name):
            if needed == this and not req.specifier.contains(upcoming):
                errors.append(f"{name} requires {req}, not {upcoming}: widen it first")
    # the members this one needs, directly or through another (its closure), in the order found
    closure, pending = [], [this]
    while pending:
        for needed, _ in needs(pending.pop()):
            if needed != this and needed not in closure:
                closure.append(needed)
                pending.append(needed)
    for name in closure:
        where, project = members[name]
        tag = f"{where.name}-v{version_of(name)}"
        if not released(where, project, tag):
            errors.append(f"{name}: its src or installed fields are not {tag}'s (or no such "
                          f"tag): release {name} first")
            continue
        try:
            if not on_index(name, version_of(name)):
                errors.append(f"{name} {version_of(name)} is not on {INDEX}, or only yanked")
        except (urllib.error.URLError, TimeoutError, ValueError, KeyError) as error:
            errors.append(f"{INDEX}, asked for {name}: {error!r}")
    for name in [this, *closure]:
        for needed, req in needs(name):
            version = version_of(needed)
            floors = [Version(s.version) for s in req.specifier if s.operator == ">="]
            if not req.specifier.contains(version):
                errors.append(f"{name} requires {req}, not {needed} {version}: widen it")
            elif not any(floor >= version for floor in floors):
                errors.append(f"{name} requires {req}: raise its floor to {version}")
    sys.exit("\n".join(f"error: {e}" for e in errors) or None)
    EOF
    fi

    # If anything below fails before the commit, put back what it changed: the manifest and the
    # lock from HEAD, and a changelog the first release created (HEAD's, not the index's: it may
    # be staged by then).
    restore() {
        echo "Release aborted -- restoring the files it changed." >&2
        git checkout HEAD -- "${manifests[@]}" uv.lock
        if git cat-file -e "HEAD:$changelog" 2> /dev/null; then
            git checkout HEAD -- "$changelog"
        else
            git rm --quiet --cached --ignore-unmatch "$changelog"
            rm -f "$changelog"
        fi
    }
    trap restore ERR

    # 5. The version, written (pyproject.toml and uv.lock); none at the first release
    if [ "$bump" = true ]; then
        "${version_of[@]}" --bump "$level" --no-sync > /dev/null
    fi
    if [ "$("${version_of[@]}")" != "$version" ]; then
        # an explicit exit runs no ERR trap: restore first
        echo "error: the version written is not $version" >&2; restore; exit 1
    fi

    # 6. The changelog, the release's section on top
    just changelog ${package:+"$package"} --tag "$tag" --output "$changelog"

    # 7. Commit, then change the trap: a refused commit (a git hook) still restores the files, but
    #    once committed, a failure is finished by hand -- a re-run would bump again
    git add "${manifests[@]}" uv.lock "$changelog"
    git commit -m "chore(release): $tag"
    finish() {
        echo "error: $tag is committed; finish it by hand: git tag -a $tag -m 'Release $tag' (unless tagged), then git push --atomic origin main $tag" >&2
    }
    trap finish ERR
    git tag -a "$tag" -m "Release $tag"

    # 8. The commit and the tag together, both or neither
    git push --atomic origin main "$tag"
    echo "Released $tag: publish.yml takes it from here."
